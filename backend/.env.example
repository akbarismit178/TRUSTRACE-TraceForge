# Copy values into your backend process environment (not Vite's .env file).
# This example is NOT automatically loaded by Python. Never commit real credentials.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-sender@gmail.com
APP_LOGIN_URL=http://localhost:3000/login
# Set your deployed frontend origin(s) here (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# When deployed behind HTTPS, set COOKIE_SECURE=true.
COOKIE_SECURE=false
# Optional: use a persistent backed-up disk location in deployment.
# EMPLOYEE_DB_PATH=C:/secure-data/trustrace/employees.sqlite3
